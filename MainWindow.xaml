<Window x:Class="Pr7_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pr7_2"
        mc:Ignorable="d"
        Title="Матрица шифр" Height="350" Width="500">
    <StackPanel Margin="10">
        <TextBlock Text="Исходный текст:"/>
        <TextBox x:Name="TextInput" Height="50" TextWrapping="Wrap" Margin="0,5"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,5,0">
                <TextBlock Text="Строк:"/>
                <TextBox x:Name="RowsInput" Text="4"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                <TextBlock Text="Столбцов:"/>
                <TextBox x:Name="ColsInput" Text="4"/>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Зашифровать" Click="EncryptButton_Click" Width="100" Margin="5"/>
            <Button Content="Расшифровать" Click="DecryptButton_Click" Width="100" Margin="5"/>
        </StackPanel>

        <TextBlock Text="Результат:"/>
        <TextBox x:Name="ResultOutput" Height="50" IsReadOnly="True" TextWrapping="Wrap" Margin="0,5"/>
    </StackPanel>
</Window>
